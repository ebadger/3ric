<?xml version="1.0" encoding="utf-8"?>
<!--
  Workaround for XAML compiler WMC1007: Explicitly add WinUI winmd references
  since the UWP workload's reference resolution is not installed.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_WinAppSdkWinmdDir>$(MSBuildThisFileDirectory)..\packages\Microsoft.WindowsAppSDK.1.6.250108002\lib\uap10.0\</_WinAppSdkWinmdDir>
    <_WebView2WinmdDir>$(MSBuildThisFileDirectory)..\packages\Microsoft.Web.WebView2.1.0.2651.64\lib\</_WebView2WinmdDir>
    <WindowsSdkPath Condition="'$(WindowsSdkPath)' == ''">C:\Program Files (x86)\Windows Kits\10\</WindowsSdkPath>
    <FacadeWinmdPath Condition="'$(FacadeWinmdPath)' == ''">$(WindowsSdkPath)UnionMetadata\10.0.26100.0\Facade\Windows.winmd</FacadeWinmdPath>
  </PropertyGroup>
  <Target Name="AddWinUIWinMDReferences" BeforeTargets="MarkupCompilePass1;MarkupCompilePass2;ClCompile">
    <ItemGroup>
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.UI.Xaml.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.UI.Text.winmd" />
      <ReferencePath Include="$(_WebView2WinmdDir)Microsoft.Web.WebView2.Core.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.ApplicationModel.DynamicDependency.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.ApplicationModel.Resources.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.ApplicationModel.WindowsAppRuntime.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.AppLifecycle.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.AppNotifications.Builder.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.AppNotifications.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.PushNotifications.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.Security.AccessControl.winmd" />
      <ReferencePath Include="$(_WinAppSdkWinmdDir)Microsoft.Windows.System.Power.winmd" />
      <ReferencePath Include="C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd" />
      <ReferenceAssemblyPaths Include="C:\Windows\Microsoft.NET\assembly\GAC_64\mscorlib\v4.0_4.0.0.0__b77a5c561934e089" />
      <ReferenceAssemblyPaths Include="C:\Program Files (x86)\Windows Kits\10\References\10.0.26100.0\Windows.Foundation.FoundationContract\4.0.0.0" />
      <ReferenceAssemblyPaths Include="C:\Program Files (x86)\Windows Kits\10\References\10.0.26100.0\Windows.Foundation.UniversalApiContract\19.0.0.0" />
      <ReferenceAssemblyPaths Include="$(MSBuildThisFileDirectory)..\packages\Microsoft.WindowsAppSDK.1.6.250108002\lib\uap10.0.18362" />
      <ReferenceAssemblyPaths Include="C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0" />
      <WinMDReferenceToCompile Include="$(_WinAppSdkWinmdDir)Microsoft.UI.Xaml.winmd" />
      <WinMDReferenceToCompile Include="$(_WinAppSdkWinmdDir)Microsoft.UI.Text.winmd" />
      <WinMDReferenceToCompile Include="$(_WebView2WinmdDir)Microsoft.Web.WebView2.Core.winmd" />
      <WinMDReferenceToCompile Include="C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd" />
    </ItemGroup>
  </Target>
  <!-- Strip CompilerIteration metadata so XamlMetaDataProvider.cpp compiles in main pass -->
  <Target Name="FixXamlGeneratedCompilerIteration" AfterTargets="CppWinRTComputeXamlGeneratedCompileInputs" BeforeTargets="ClCompile">
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.CompilerIteration)' == 'XamlGenerated'">
        <CompilerIteration></CompilerIteration>
      </ClCompile>
    </ItemGroup>
  </Target>
  <!-- Add WebView2 winmd so CppWinRT can resolve Microsoft.Web.WebView2.Core types -->
  <Target Name="AddWebView2CppWinRTReference" BeforeTargets="CppWinRTMakeProjections;GetCppWinRTDirectWinMDReferences;GetCppWinRTPlatformWinMDReferences;GetCppWinRTPlatformWinMDInputs">
    <ItemGroup>
      <CppWinRTPlatformWinMDReferences Include="$(_WebView2WinmdDir)Microsoft.Web.WebView2.Core.winmd">
        <WinMDPath>$(_WebView2WinmdDir)Microsoft.Web.WebView2.Core.winmd</WinMDPath>
      </CppWinRTPlatformWinMDReferences>
    </ItemGroup>
  </Target>
</Project>
